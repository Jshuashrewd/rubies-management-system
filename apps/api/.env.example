# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/rubies"

# Long random string used to sign JWTs — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Resend API key — https://resend.com/api-keys. Leave unset to skip
# sending emails during local development (they'll be logged instead).
RESEND_API_KEY=""
REPORT_EMAIL_FROM="Rubies Code School <reports@rubiescodeschool.com>"

# Port the API listens on locally.
PORT=3001
